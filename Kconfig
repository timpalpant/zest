menuconfig ZEST
	bool "Zest C++23 services"
	depends on CPP && STD_CPP23 && REQUIRES_FULL_LIBCPP
	help
	  Allocation-conscious, idiomatic C++23 wrappers for common Zephyr
	  services.

if ZEST

config ZEST_ERROR_STRINGS
	bool "Error descriptions"
	default y
	help
	  Compile the table behind zest::Error::message(). Costs roughly 700 bytes
	  of read-only storage. Disable it on a flash-tight image; message() then
	  returns a placeholder and the numeric code remains available via value().

config ZEST_ADC_CHANNEL
	bool "AdcChannel"
	depends on ADC
	help
	  Typed, devicetree-configured ADC reads with raw, millivolt, and averaged
	  results.

config ZEST_GPIO
	bool "GPIO inputs and outputs"
	depends on GPIO
	help
	  Typed polling and interrupt-driven digital inputs, and digital outputs,
	  using logical active/inactive states.

config ZEST_I2S
	bool "I2S capture and playback"
	depends on I2S
	help
	  I2S streams with the memory-slab block returned by a scope rather than by
	  hand. i2s_read() transfers a slab block to the caller, and any path that
	  forgets k_mem_slab_free() starves the RX queue a few blocks later — which
	  presents as the stream stopping rather than as a leak.

	  The slab itself stays the application's: its block size sets the stream's
	  latency and its block count sets how much jitter the far side may add.

config ZEST_FLASH_PARTITION
	bool "FlashPartition"
	depends on FLASH_MAP
	help
	  A self-closing handle to one fixed partition, for read-mostly assets kept
	  outside the image — a sound bank, a lookup table, a firmware slot header.
	  Every access is bounded against the partition size, so an out-of-range
	  offset is an error rather than a short read the caller cannot detect.

config ZEST_BUTTON
	bool "Button"
	depends on GPIO
	select ZEST_GPIO
	help
	  Poll-driven debounced button with click and long-press events.

config ZEST_LED_PATTERN
	bool "LedPatternPlayer"
	depends on GPIO
	select ZEST_GPIO
	help
	  Fixed-storage, poll-driven GPIO status patterns.

config ZEST_PWM_OUTPUT
	bool "PWM outputs and actuators"
	depends on PWM
	help
	  Typed PWM output, dimmable and RGB LEDs, servo, and buzzer helpers.

config ZEST_JSON
	bool "JSON codec"
	depends on JSON_LIBRARY
	help
	  Serialize structs to and from JSON through Zephyr's JSON library, driven
	  by a ZEST_SCHEMA declaration.

	  Enable CONFIG_JSON_LIBRARY_FP_SUPPORT for float or double members.

config ZEST_CBOR
	bool "CBOR codec"
	depends on ZCBOR
	help
	  Serialize structs to and from CBOR through zcbor, driven by the same
	  ZEST_SCHEMA declaration the JSON codec uses.

	  CBOR is roughly half the size of the equivalent JSON, decoding does not
	  modify the input buffer, and nothing depends on NUL termination. Prefer it
	  where both ends of the link are yours.

config ZEST_I2C
	bool "I2cDevice"
	depends on I2C
	help
	  Typed I2C register and burst access, for a part with no Zephyr driver.

config ZEST_SPI
	bool "SpiDevice"
	depends on SPI
	help
	  Typed SPI transfers, for a part with no Zephyr driver.

config ZEST_UART
	bool "Uart"
	depends on SERIAL
	help
	  Polled UART access with bounded waits, for a module that speaks ASCII or a
	  simple framed protocol.

config ZEST_SENSOR
	bool "Read-and-Decode sensor access"
	depends on SENSOR && SENSOR_ASYNC_API && RTIO
	help
	  Typed blocking, batched, and RTIO mempool-backed sensor reads with
	  fixed-storage channel and periodic sampling helpers.

config ZEST_SETTINGS
	bool "Settings"
	depends on SETTINGS
	help
	  Fixed-storage byte and trivially-copyable typed access to a Zephyr
	  settings subtree. Storage backend selection remains application policy.

config ZEST_NETWORK
	bool "DNS and socket wrappers"
	depends on NETWORKING && NET_SOCKETS && DNS_RESOLVER
	help
	  Fixed-result DNS resolution and move-only TCP and UDP sockets.

config ZEST_SNTP_CLIENT
	bool "SNTP client"
	depends on NETWORKING && NET_SOCKETS && SNTP
	help
	  Query network time without changing the system clock.

config ZEST_TIME_SYNCHRONIZER
	bool "Network time synchronization"
	depends on NETWORKING && NET_SOCKETS && SNTP && POSIX_TIMERS
	select ZEST_SNTP_CLIENT
	help
	  Query network time and update CLOCK_REALTIME.

config ZEST_NETWORK_MONITOR
	bool "Network interface monitor"
	depends on NETWORKING && NET_MGMT && NET_IPV4
	help
	  Observe interface and IP-address readiness and wait for IPv4. IPv6 is
	  reported when CONFIG_NET_IPV6 is enabled by the application.

config ZEST_MQTT_CLIENT
	bool "MQTT client"
	depends on MQTT_LIB && NETWORKING && NET_SOCKETS && DNS_RESOLVER
	select ZEST_NETWORK
	help
	  Fixed-buffer MQTT client with explicit event-loop integration.

config ZEST_CERTIFICATE_STORE
	bool "TLS certificate store"
	depends on TLS_CREDENTIALS
	help
	  Fixed-storage ownership for credentials registered with Zephyr TLS.

config ZEST_PROVISIONING_MANAGER
	bool "Wi-Fi provisioning manager"
	depends on SETTINGS
	select ZEST_SETTINGS
	help
	  Persistent, bounded Wi-Fi credential storage.

config ZEST_SYSTEM
	bool

config ZEST_DEVICE_IDENTITY
	bool "Reset reason and device identity"
	depends on HWINFO
	select ZEST_SYSTEM

config ZEST_WATCHDOG
	bool "Watchdog"
	depends on WATCHDOG
	select ZEST_SYSTEM

config ZEST_RTC
	bool "Real-time clock"
	depends on RTC
	select ZEST_SYSTEM

config ZEST_POWER_MANAGER
	bool "Power manager"
	depends on PM
	select ZEST_SYSTEM

config ZEST_BATTERY_MONITOR
	bool "BatteryMonitor"
	depends on ADC
	select ZEST_ADC_CHANNEL
	help
	  ADC-backed battery voltage monitor, in zest/battery.hpp.

	  The discharge-curve half of that header needs no Kconfig option and no
	  Zephyr facility; this option adds BatteryMonitor on top of it.

config ZEST_HTTP_CLIENT
	bool "HttpClient"
	depends on NETWORKING && NET_SOCKETS && NET_TCP
	depends on DNS_RESOLVER && HTTP_CLIENT
	help
	  Synchronous HTTP/1.1 client with caller-owned response storage.

	  TLS is a separate option, so a device that only talks to a plain-HTTP
	  endpoint does not pull in mbedTLS and its heap.

if ZEST_HTTP_CLIENT

config ZEST_HTTP_CLIENT_TLS
	bool "HTTPS support"
	default y
	depends on NET_SOCKETS_SOCKOPT_TLS
	help
	  Enable https:// URLs, peer verification and SNI. Without this an https URL
	  is refused at the TLS configuration stage.

config ZEST_HTTP_RECV_BUF_SIZE
	int "Receive chunk size"
	default 1024
	range 256 8192
	help
	  Size of the stack buffer HttpClient::request() gives Zephyr's HTTP client
	  for incremental parsing. This dominates the call's stack cost, so lower it
	  on a small thread and raise it for large headers.

config ZEST_HTTP_MAX_URL_LEN
	int "Maximum URL length"
	default 512
	range 128 2048
	help
	  Longest accepted request URL. The parsed host and path are held on the
	  stack, so this contributes directly to the stack cost of a request.

endif # ZEST_HTTP_CLIENT

config ZEST_FIRMWARE_UPDATE
	bool "FirmwareUpdate"
	depends on MCUBOOT_IMG_MANAGER
	help
	  Staging an MCUboot image into the spare slot, arming the bootloader, and
	  confirming the running image so a swapping bootloader does not revert it.

	  Transport is deliberately not covered: where the bytes come from is the
	  application's, and every source has its own authentication and retry
	  policy. What is here is the part that is identical for all of them.

	  This depends on MCUBOOT_IMG_MANAGER, which is what actually builds
	  flash_img.c and the boot_*() calls, rather than on BOOTLOADER_MCUBOOT.
	  The latter is about where the application image is linked, which is a
	  property of the build and not something this code needs.

config ZEST_USB_DEVICE
	bool "UsbDevice"
	depends on USB_DEVICE_STACK_NEXT
	help
	  The bring-up sequence for a usbd_context built by the USBD_*_DEFINE
	  macros: descriptors, configuration, classes, code triple, message
	  callback, init, and enable — in the one order that works, with the
	  VBUS-driven enable handled where the controller reports it.

config ZEST_SHELL
	bool "Shell argument helpers"
	depends on SHELL
	help
	  Bounds-checked, typed access to a shell command's (argc, argv), and
	  Error-aware reporting. The SHELL_CMD macros stay as they are; this is the
	  parsing and printing on either side of them.

config ZEST_BYTE_RING
	bool "ByteRing"
	help
	  A byte-oriented ring buffer with zero-copy claim/finish access, for the
	  ISR and DMA paths that want to write into the buffer's own storage rather
	  than hand over an assembled element. SpscRingBuffer remains the right
	  choice for a stream of values.

config ZEST_BUFFERED_UART
	bool "BufferedUart"
	depends on SERIAL
	depends on UART_INTERRUPT_DRIVEN
	select ZEST_BYTE_RING
	help
	  Interrupt-driven UART with a receive and a transmit ring. ZEST_UART is the
	  polling API and remains the right one for a sensor that answers a command
	  every few hundred milliseconds; this is for a link carrying a continuous
	  stream, where polling either burns a thread or drops bytes.

config ZEST_WIFI_MANAGER
	bool "WifiManager"
	depends on NETWORKING && NET_IPV4 && WIFI
	select NET_MGMT_EVENT_INFO
	help
	  Synchronous Wi-Fi station lifecycle wrapper that owns association retries
	  and waits for DHCP.

config ZEST_BLE
	bool "BLE primitives"
	depends on BT
	depends on BT_CONN
	help
	  Primitives for building on Zephyr's Bluetooth LE API directly:
	  BleConnection (an owning bt_conn reference), BleAddress, ble_connect(),
	  and BleConnectionObserver, a role-filtered view of the connection
	  callbacks that Zephyr otherwise broadcasts to every registration.

	  These sit below the profile layer and do not own the stack, register a
	  profile, or assume a single connection, so they compose with hand-written
	  GATT, BAP or A2DP code rather than standing in front of it. Use them
	  instead of ZEST_BLUETOOTH_MANAGER whenever the application holds more
	  than one link or drives a profile itself.

config ZEST_BLUETOOTH_MANAGER
	bool "BluetoothManager"
	depends on BT
	depends on BT_CENTRAL || BT_PERIPHERAL
	help
	  A single-link BLE convenience: enable the stack, advertise, accept or
	  make one connection, and watch its state.

	  It takes the stack's connection callbacks for itself and holds exactly
	  one bt_conn, so a second instance is inert and every operation on it
	  reports errors::no_device. An application that holds two links, drives a
	  profile of its own, or needs the opposite role on a second link wants
	  ZEST_BLE's primitives instead — they neither own the callbacks nor assume
	  a single connection.

	  This depends on Bluetooth rather than selecting it: force-selecting a
	  subsystem bypasses its own dependency checks, which turns "no controller
	  on this board" into a confusing unsatisfied-dependency warning instead of
	  the option simply being unavailable. Enable CONFIG_BT and the role you
	  need in the application.

	  Set CONFIG_BT_DEVICE_NAME_DYNAMIC=y to use enable()'s device-name
	  argument.

endif
